{
  "bsonType": "object",
  "required": ["familyId", "name"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "主键（服务端生成）"
    },
    "familyId": {
      "bsonType": "string",
      "title": "所属家庭空间 ID"
    },
    "userId": {
      "bsonType": ["string", "null"],
      "title": "绑定的登录账号 UID（空=未绑定的虚拟成员）"
    },
    "mobile": {
      "bsonType": ["string", "null"],
      "title": "绑定的手机号（管理员预设，用户用该手机号登录后自动关联）"
    },
    "name": {
      "bsonType": "string",
      "title": "姓名",
      "maxLength": 20
    },
    "role": {
      "bsonType": "string",
      "title": "家庭关系：father/mother/grandfather/grandmother/maternalGrandfather/maternalGrandmother/son/daughter/other"
    },
    "gender": {
      "bsonType": "string",
      "title": "性别：male / female / other"
    },
    "birthday": {
      "bsonType": "string",
      "title": "出生日期 YYYY-MM-DD"
    },
    "height": {
      "bsonType": ["double", "null"],
      "title": "身高（cm）"
    },
    "weight": {
      "bsonType": ["double", "null"],
      "title": "体重（kg）"
    },
    "targetWeight": {
      "bsonType": ["double", "null"],
      "title": "目标体重（kg）"
    },
    "avatarColor": {
      "bsonType": "string",
      "title": "头像颜色"
    },
    "avatarUrl": {
      "bsonType": ["string", "null"],
      "title": "头像图片 URL（微信头像授权后使用）"
    },
    "isSelf": {
      "bsonType": "bool",
      "title": "是否本人档案"
    },
    "bindCode": {
      "bsonType": ["string", "null"],
      "title": "成员绑定码（6位，用于虚拟成员绑定登录账号）"
    },
    "bindCodeExpiresAt": {
      "bsonType": ["timestamp", "null"],
      "title": "绑定码过期时间"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "title": "创建时间"
    },
    "updatedAt": {
      "bsonType": "timestamp",
      "title": "更新时间"
    }
  }
}

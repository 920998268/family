{
  "bsonType": "object",
  "required": ["familyId", "clientId", "planId", "date"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "主键（服务端生成）"
    },
    "familyId": {
      "bsonType": "string",
      "title": "所属家庭空间 ID（服务端从登录态推导，不接受客户端传入）"
    },
    "clientId": {
      "bsonType": "string",
      "title": "客户端打卡 ID，幂等键（家庭内唯一）",
      "maxLength": 64
    },
    "planId": {
      "bsonType": "string",
      "title": "所属计划（study_plans.clientId）；写入前必须校验其存在且属于本家庭",
      "maxLength": 64
    },
    "date": {
      "bsonType": "string",
      "title": "打卡日期 YYYY-MM-DD（字符串，服务端不做时区换算）"
    },
    "note": {
      "bsonType": "string",
      "title": "备注：**必为字符串**，空备注落空串而非 null（落 null 会让前端整条打卡被静默丢弃）",
      "maxLength": 100
    },
    "memberId": {
      "bsonType": ["string", "null"],
      "title": "打卡成员（family_members._id；不属于本家庭时服务端置 null）"
    },
    "createdByUid": {
      "bsonType": "string",
      "title": "创建者 uid（审计用）"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "title": "创建时间"
    },
    "updatedAt": {
      "bsonType": "timestamp",
      "title": "更新时间"
    }
  }
}

{
  "name": "fitness-diet-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "MVP fitness and diet tracking app built with uni-app, Vue 3, TypeScript, and Pinia.",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020520260829001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260829001",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260829001",
    "@types/node": "20.12.12",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/tsconfig": "0.5.1",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vitest": "2.0.5",
    "vue-tsc": "2.0.29"
  }
}
